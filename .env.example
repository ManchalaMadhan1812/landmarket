# LandMarket Environment Variables
# Copy this file to .env and update the values

# Development/Production Mode
DEBUG=True
DJANGO_SECRET_KEY=your-super-secret-key-here

# Database Configuration
DATABASE_URL=postgresql://landmarket_user:landmarket_password@localhost:5432/landmarket

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Elasticsearch Configuration
ELASTICSEARCH_URL=http://localhost:9200

# Google Maps Platform API Key
# Required for: Maps, Places, Geocoding, Directions
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Razorpay Payment Gateway (India)
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# AWS S3 or Cloudflare R2 for file storage
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_REGION_NAME=ap-south-1
AWS_STORAGE_BUCKET_NAME=landmarket-media

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# Sentry for Error Monitoring (Optional)
SENTRY_DSN=your-sentry-dsn

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000/api
REACT_APP_WS_URL=ws://localhost:8000/ws
REACT_APP_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Security Headers
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_ENABLED=True
AUTH_RATE_LIMIT=5/min
SEARCH_RATE_LIMIT=30/min

# File Upload Limits
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
MAX_IMAGES_PER_PROPERTY=10
MAX_DOCUMENTS_PER_PROPERTY=5

# Cache Configuration
CACHE_TIMEOUT=3600  # 1 hour
SEARCH_CACHE_TIMEOUT=300  # 5 minutes